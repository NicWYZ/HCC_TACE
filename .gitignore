*.csv

# Generated figures and tables (regenerated by the pipeline)
results/**
!results/.gitkeep

# Manuscript drafts, slides, reference papers and other local-only files
private/
*.pdf
*.docx
*.xlsx
*.pptx
*.zip
*.html
